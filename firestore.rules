rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Connection health check document
    match /test/{docId} {
      allow get, list: if true;
      allow write: if false;
    }

    // 1. Monthly Duty Rosters (Nöbet Çizelgeleri)
    // Public get and list for all hospital staff and visitors
    // Path variable isValidId applies to document ops
    match /duty_rosters/{rosterId} {
      allow get: if isValidId(rosterId);
      allow list: if true;
      allow create, update, delete: if isValidId(rosterId);
    }

    // 2. Weekly Operating Room Work Schedules (Haftalık Çalışma Programı)
    // Public get and list for all hospital staff and visitors
    match /weekly_schedules/{scheduleId} {
      allow get: if isValidId(scheduleId);
      allow list: if true;
      allow create, update, delete: if isValidId(scheduleId);
    }

    // 3. Schedule Metadata (Aktif Ay ve Aktif Hafta Göstergeleri)
    // Public get and list for all visitors
    match /schedule_meta/{metaId} {
      allow get: if isValidId(metaId);
      allow list: if true;
      allow create, update, delete: if isValidId(metaId);
    }
  }
}
